# Environment Configuration for Agentic Vending Machines
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# General Configuration
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# Storage Configuration
# =============================================================================
# Set to 'true' to use Redis instead of in-memory storage
USE_REDIS=false

# Redis connection URL (only needed if USE_REDIS=true)
REDIS_URL=redis://localhost:6379

# =============================================================================
# x402 Vending Machine (Port 3000)
# =============================================================================
X402_PORT=3000

# Crypto Payment Configuration
# Supported tokens: USDC, ETH, DAI
X402_PAYMENT_ADDRESS=0x1234567890123456789012345678901234567890
X402_ACCEPTED_TOKENS=USDC,ETH,DAI

# Pricing (in smallest unit: cents for USD, wei for ETH)
X402_COFFEE_PRICE=500
X402_TEA_PRICE=300

# =============================================================================
# AP2 Vending Machine (Port 3001)
# =============================================================================
AP2_PORT=3001

# JWT Configuration for Verifiable Credentials
AP2_JWT_SECRET=your-secret-key-here-change-in-production
AP2_JWT_ISSUER=https://your-domain.com

# Authorized Vendors (comma-separated)
AP2_AUTHORIZED_VENDORS=google-shopping-agent,enterprise-bot-001

# Transaction Limits
AP2_MAX_TRANSACTION_AMOUNT=10000
AP2_DAILY_LIMIT=100000

# =============================================================================
# ACP Vending Machine (Port 3002)
# =============================================================================
ACP_PORT=3002

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# AI Agent Detection
ACP_ENABLE_AGENT_DETECTION=true
ACP_FRAUD_SCORE_THRESHOLD=70

# =============================================================================
# Mastercard Agent Pay Vending Machine (Port 3003)
# =============================================================================
MASTERCARD_PORT=3003

# Mastercard API Configuration
# Get your credentials from Mastercard Developer Portal
MASTERCARD_API_KEY=your_mastercard_api_key_here
MASTERCARD_CLIENT_ID=your_client_id_here
MASTERCARD_CLIENT_SECRET=your_client_secret_here

# Environment: sandbox or production
MASTERCARD_ENVIRONMENT=sandbox
MASTERCARD_API_URL=https://sandbox.api.mastercard.com

# Agent Authentication
MASTERCARD_ENABLE_AGENT_AUTH=true
MASTERCARD_AUTHORIZED_AGENTS=corporate-agent-001,finance-bot-002

# =============================================================================
# Security Configuration
# =============================================================================
# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=*

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production
SESSION_TTL=1800

# =============================================================================
# Monitoring & Analytics (Optional)
# =============================================================================
# Datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=

# New Relic
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=agentic-vending-machine

# Sentry
SENTRY_DSN=

# =============================================================================
# Development & Testing
# =============================================================================
# Mock Payments (bypass real payment processing)
MOCK_PAYMENTS=false

# Debug Mode
DEBUG=false
