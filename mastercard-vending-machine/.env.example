# Mastercard Vending Machine Environment Configuration

# Server Configuration
MASTERCARD_PORT=3003
NODE_ENV=development

# Mastercard API Configuration
# Get your credentials from https://developer.mastercard.com/
MASTERCARD_API_KEY=your_api_key_here
MASTERCARD_CLIENT_ID=your_client_id_here
MASTERCARD_CLIENT_SECRET=your_client_secret_here

# Environment: sandbox or production
MASTERCARD_ENVIRONMENT=sandbox
MASTERCARD_API_URL=https://sandbox.api.mastercard.com

# Agent Authorization
# Enable agent authorization checks
MASTERCARD_ENABLE_AGENT_AUTH=true

# Comma-separated list of authorized agent IDs
# Leave empty to allow all agents
MASTERCARD_AUTHORIZED_AGENTS=corporate-agent-001,finance-bot-002

# Storage Configuration
USE_REDIS=false
REDIS_URL=redis://localhost:6379

# Mock Payments
# Set to 'false' to use real Mastercard API
MOCK_PAYMENTS=true

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*
