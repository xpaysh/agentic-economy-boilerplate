# ACP Vending Machine Configuration
PORT=3003
DOMAIN=https://your-domain.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (created in Stripe Dashboard)
STRIPE_PRICE_AI_PREMIUM=price_ai_premium_monthly
STRIPE_PRICE_PRODUCTIVITY=price_productivity_suite
STRIPE_PRICE_DATA_INSIGHTS=price_data_insights_monthly
STRIPE_PRICE_VOICE=price_voice_synthesis

# OpenAI Integration (for enhanced AI agent detection)
OPENAI_API_KEY=sk-your_openai_api_key

# Fraud Prevention
FRAUD_DETECTION_ENABLED=true
MAX_FRAUD_SCORE=90
ENHANCED_SECURITY_THRESHOLD=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# Logging
LOG_LEVEL=info
LOG_FILE=acp-vending.log

# Security
SESSION_SECRET=your_session_secret
CORS_ORIGINS=https://your-frontend.com,http://localhost:3000