# x402 Vending Machine Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# x402 Protocol Configuration
NETWORK=base
RECIPIENT_ADDRESS=0x742d35Cc6634C0532925a3b8D440609653cbe

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/

# Optional: Database Configuration (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/x402_vending
# REDIS_URL=redis://localhost:6379

# Optional: Monitoring Configuration
# DATADOG_API_KEY=your_datadog_key
# NEW_RELIC_LICENSE_KEY=your_newrelic_key

# Optional: Webhook Configuration (for real-time payment notifications)
# WEBHOOK_SECRET=your_webhook_secret
# WEBHOOK_URL=https://your-app.com/webhooks/payment-update