# AP2 Vending Machine Configuration
PORT=3002

# Enterprise Identity Provider Settings
ENTERPRISE_IDP_URL=https://identity.techcorp.com
ENTERPRISE_IDP_ISSUER=did:web:identity.techcorp.com

# Payment Rail Configuration
MASTERCARD_API_KEY=your_mastercard_api_key
VISA_API_KEY=your_visa_api_key
CORPORATE_CARD_PROVIDER=stripe_connect

# x402 Integration (for crypto payments)
X402_NETWORK=base
X402_RPC_URL=https://base.llamarpc.com
X402_FACILITATOR_URL=https://facilitator.base.example.com

# Compliance & Audit
AUDIT_ENDPOINT=https://audit.techcorp.com/ap2
COMPLIANCE_WEBHOOK=https://compliance.techcorp.com/webhooks/ap2

# Security
JWT_SECRET=your_jwt_secret_for_ap2_sessions
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100